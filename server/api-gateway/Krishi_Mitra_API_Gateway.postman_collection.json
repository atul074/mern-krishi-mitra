              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{user_id}}\",\n  \"cartItems\": [\n    {\n      \"productId\": \"{{product_id}}\",\n      \"title\": \"Organic Fertilizer\",\n      \"image\": \"fertilizer.jpg\",\n      \"price\": 500,\n      \"quantity\": 2\n    }\n  ],\n  \"addressInfo\": {\n    \"addressId\": \"address_id_here\",\n    \"address\": \"123 Farm Road\",\n    \"city\": \"Rural Town\",\n    \"pincode\": \"123456\",\n    \"phone\": \"9876543210\"\n  },\n  \"orderStatus\": \"pending\",\n  \"paymentMethod\": \"paypal\",\n  \"paymentStatus\": \"pending\",\n  \"totalAmount\": 1000,\n  \"orderDate\": \"2024-01-15T10:30:00.000Z\",\n  \"orderUpdateDate\": \"2024-01-15T10:30:00.000Z\"\n}"
            },
            "url": {
