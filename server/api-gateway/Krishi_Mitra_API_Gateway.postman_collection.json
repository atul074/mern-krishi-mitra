            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{user_id}}\",\n  \"productId\": \"{{product_id}}\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/shop/cart/add",
              "host": ["{{base_url}}"],
              "path": ["api", "shop", "cart", "add"]
