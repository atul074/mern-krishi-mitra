            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/shop/cart/{{user_id}}/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "shop", "cart", "{{user_id}}", "{{product_id}}"]
